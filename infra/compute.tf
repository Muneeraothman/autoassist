data "aws_ami" "amazon_linux" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# --- SSH key pair ------------------------------------------------------------
# Generated by Terraform (app-internal cryptographic material, not a
# third-party credential) so Muneera can SSH in for debugging if needed.
# Private key saved locally, git-ignored, never committed.

resource "tls_private_key" "ec2" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "ec2" {
  key_name   = "autoassist-ec2-key"
  public_key = tls_private_key.ec2.public_key_openssh
}

resource "local_sensitive_file" "ec2_private_key" {
  content         = tls_private_key.ec2.private_key_pem
  filename        = "${path.module}/autoassist-ec2-key.pem"
  file_permission = "0600"
}

# --- IAM role for the EC2 instance --------------------------------------------
# Instance role, not static access keys baked into the instance — the whole
# point of this pattern (see HANDOFF.md's discussion of autoassist-dev vs.
# autoassist-terraform for the same reasoning applied one level down: the
# deployed app's own runtime identity shouldn't be the same as anything used
# to provision infrastructure, and shouldn't be static keys at all when an
# instance role can do the job with automatic credential rotation).

resource "aws_iam_role" "ec2" {
  name = "autoassist-ec2-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action    = "sts:AssumeRole"
        Effect    = "Allow"
        Principal = { Service = "ec2.amazonaws.com" }
      }
    ]
  })
}

resource "aws_iam_role_policy" "ec2_ses" {
  name = "autoassist-ec2-ses-policy"
  role = aws_iam_role.ec2.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["ses:SendEmail", "ses:SendRawEmail"]
        Resource = "*"
      }
    ]
  })
}

resource "aws_iam_role_policy" "ec2_s3" {
  name = "autoassist-ec2-s3-policy"
  role = aws_iam_role.ec2.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["s3:PutObject", "s3:GetObject"]
        Resource = "arn:aws:s3:::${var.s3_receipts_bucket}/*"
      }
    ]
  })
}

resource "aws_iam_instance_profile" "ec2" {
  name = "autoassist-ec2-profile"
  role = aws_iam_role.ec2.name
}

# --- EC2 instance --------------------------------------------------------------

resource "aws_instance" "app" {
  ami                    = data.aws_ami.amazon_linux.id
  instance_type          = var.instance_type
  subnet_id              = aws_subnet.public[0].id
  vpc_security_group_ids = [aws_security_group.ec2.id]
  iam_instance_profile   = aws_iam_instance_profile.ec2.name
  key_name               = aws_key_pair.ec2.key_name

  user_data = templatefile("${path.module}/user_data.sh.tpl", {
    deploy_bucket    = var.s3_receipts_bucket
    aws_region       = var.aws_region
    db_password      = var.db_password
    rds_endpoint     = aws_db_instance.main.endpoint
    jwt_secret_key   = var.jwt_secret_key
    ses_sender_email = var.ses_sender_email
    s3_bucket_name   = var.s3_receipts_bucket
  })

  tags = {
    Name = "autoassist-app"
  }
}
